[Unit]
Description=iHeart fullscreen booth browser
Requires=iheart-caddy.service
After=iheart-caddy.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WorkingDirectory=%h/demos/crf-demo/lyh
ExecStart=/usr/bin/gnome-session-inhibit --inhibit idle --reason "iHeart booth display" /usr/bin/python3 %h/demos/crf-demo/lyh/kiosk.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
